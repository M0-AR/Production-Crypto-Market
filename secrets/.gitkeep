# Secrets are FILES, never env vars (env leaks via `docker inspect` + logs).
# Create before first prod up:
#   openssl rand -hex 32 > secrets/postgres_password.txt
#   openssl rand -hex 32 > secrets/jwt_secret.txt
#   echo -n "your-coingecko-key" > secrets/coingecko_key.txt
#   chmod 600 secrets/*.txt
# Dev uses compose.override.yml defaults — no secrets needed locally.
